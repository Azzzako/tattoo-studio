# Application
APP_URL="https://tattoo-studio.example.com"

# Token que habilita el endpoint /api/dev/auth-link en produccion.
# Generar con: openssl rand -hex 32
# Setear en Vercel (Production) y .env local con el mismo valor.
# Si rota, redeploy. Cualquier peticion sin este token recibe 401.
DEV_ADMIN_TOKEN=""
APP_NAME="Tattoo Studio"
STUDIO_ID="00000000-0000-0000-0000-000000000001"
DEFAULT_TZ="America/Mexico_City"
DEFAULT_LOCALE="es-MX"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
# Public mirrors (exposed to the browser bundle). Keep in sync.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SITE_URL=""

# Encryption
TOKEN_ENCRYPTION_KEY=""

# Resend (email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@tattoo-studio.example.com"

# Google Calendar
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Cloudflare (deploy)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
